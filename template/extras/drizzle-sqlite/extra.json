{
  "package": {
    "dependencies": {
      "drizzle-orm": "0.45.2"
    },
    "devDependencies": {
      "@types/bun": "1.4.0",
      "drizzle-kit": "0.31.10"
    },
    "scripts": {
      "db:generate": "drizzle-kit generate && oxfmt drizzle",
      "db:migrate": "bun scripts/migrate.ts",
      "db:studio": "drizzle-kit studio"
    }
  },
  "env": [
    {
      "key": "DATABASE_URL",
      "side": "server",
      "zod": "z.string()",
      "example": "file:./dev.db"
    }
  ],
  "agents": "Drizzle with bun SQLite. `DATABASE_URL=file:./dev.db`. Schema in `src/server/db`. Scripts: `db:generate`, `db:migrate`, `db:studio`. No sample Post table. Queries go through Route Handlers, not tRPC."
}
