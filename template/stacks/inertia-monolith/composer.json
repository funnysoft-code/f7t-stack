{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "funnysoft/inertia",
  "type": "project",
  "description": "A FunnySoft Laravel and Inertia application.",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "inertiajs/inertia-laravel": "^3.0",
    "laravel/fortify": "1.39.0",
    "laravel/framework": "^13.29",
    "laravel/horizon": "^5.0",
    "laravel/nightwatch": "1.30.0",
    "laravel/octane": "^2.0",
    "laravel/passkeys": "0.2.1",
    "laravel/wayfinder": "^0.1.21",
    "nunomaduro/essentials": "^1.0",
    "resend/resend-php": "1.13.0",
    "spatie/laravel-data": "^4.0",
    "spatie/laravel-permission": "^7.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.0",
    "driftingly/rector-laravel": "^2.6.1",
    "funnysoft/boost-guidelines": "@dev",
    "larastan/larastan": "^3.10",
    "laravel/boost": "^2.7.0",
    "laravel/pint": "^1.30.5",
    "pestphp/pest": "^5.1.3",
    "pestphp/pest-plugin-laravel": "^5.0.1",
    "pestphp/pest-plugin-phpstan": "^5.2.0",
    "pestphp/pest-plugin-rector": "^5.0.4",
    "pestphp/pest-plugin-type-coverage": "^5.0.2",
    "phpstan/phpstan": "^2.1",
    "rector/rector": "^2.6.4",
    "spatie/laravel-typescript-transformer": "^3.3"
  },
  "repositories": [
    {
      "type": "path",
      "url": "packages/boost-guidelines",
      "options": {
        "symlink": false
      }
    }
  ],
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-update-cmd": [
      "@php artisan boost:update --ansi",
      "bash scripts/boost-sync-opencode-skills.sh"
    ]
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "extra": {
    "laravel": {
      "dont-discover": [
        "laravel/nightwatch"
      ]
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
