{
  "name": "__F7T_APP_NAME__",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/api-client",
    "packages/design-system"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "start": "bun run --cwd apps/web start",
    "lint": "bash scripts/frontend-gate.sh lint",
    "typecheck": "bash scripts/frontend-gate.sh typecheck",
    "test": "bash scripts/frontend-gate.sh test",
    "doctor": "bash scripts/frontend-gate.sh doctor",
    "test:e2e": "bash scripts/frontend-gate.sh e2e",
    "check:php": "bash scripts/php-gate.sh all",
    "check:schema": "bash scripts/frontend-gate.sh schema",
    "check:workflows": "bash scripts/frontend-gate.sh workflows",
    "api:generate": "bash scripts/generate-api-client.sh --write",
    "hooks:install": "lefthook install",
    "check": "bun run check:php && bun run lint && bun run typecheck && bun run test && bun run doctor && bun run check:schema && bun run check:workflows"
  },
  "devDependencies": {
    "@f7t/api-client": "workspace:*",
    "@f7t/design-system": "workspace:*",
    "@playwright/test": "1.62.1",
    "@types/node": "24.10.1",
    "@vitest/coverage-v8": "4.1.11",
    "lefthook": "2.1.12",
    "openapi-typescript": "7.13.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "react-doctor": "0.9.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "packageManager": "bun@1.4.0"
}
